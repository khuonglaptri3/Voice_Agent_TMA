# Dockerfile for Real-time Voice Agent Pipeline (CUDA & WebRTC)
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

WORKDIR /app
RUN apt-get update && apt-get install -y python3 python3-pip ffmpeg libasound2-dev && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip3 install --no-cache-dir -e .

COPY . .
CMD ["python3", "src/serving/main.py", "--mode", "voice"]
